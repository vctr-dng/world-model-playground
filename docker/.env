# MLflow
MLFLOW_VERSION=latest
MLFLOW_PORT=5000

# Host interface the port is published on. Only clients that can reach this
# address can reach MLflow — set to an IP on the 192.168.193.0/24 network to
# restrict access to that subnet (0.0.0.0 would expose it on every interface).
MLFLOW_BIND_ADDRESS=192.168.193.150
