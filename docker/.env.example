# MLflow server settings. up.sh copies this file to .env when .env is missing,
# then writes HOST_UID and HOST_GID into .env so the container can write
# ./mlflow-data as you.
MLFLOW_VERSION=latest
MLFLOW_PORT=5000

# Host interface the port is published on, besides 127.0.0.1, which is always
# published. 0.0.0.0 exposes MLflow on every interface; set an IP of a trusted
# network to restrict access to clients that can reach it.
MLFLOW_BIND_ADDRESS=0.0.0.0
